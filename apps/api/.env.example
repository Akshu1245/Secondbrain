# ---- Storage ----
# DATA_DIR=/var/data         # Render persistent disk mount

# ---- Auth ----
# API_TOKEN=                 # required in production; clients pass `Authorization: Bearer <token>`

# ---- Web ----
# CORS_ORIGINS=https://second-brain.vercel.app,https://your-vercel-preview.vercel.app

# ---- LLM (any one is enough; auto-detected) ----
# LLM_PROVIDER=auto           # auto | openai | openrouter | ollama | fallback
# LLM_MODEL=                  # provider default if empty
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Whisper (optional, opt-in; CPU-only is slow) ----
# ENABLE_WHISPER=false
# WHISPER_MODEL=base

# ---- Telegram (optional) ----
# TELEGRAM_BOT_TOKEN=
